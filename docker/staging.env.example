# Copy to /opt/workout_bot/compose/staging.env on the staging host.
# Replace every placeholder outside Git. Do not use production secrets.
POSTGRES_DB=workout_bot_staging
POSTGRES_USER=workout_bot_staging
POSTGRES_PASSWORD=<staging-postgres-secret>
MINIO_ROOT_USER=workout_staging
MINIO_ROOT_PASSWORD=<staging-minio-secret>
