# Application staging environment.
# Copy to /opt/workout_bot/compose/staging-app.env on the staging host,
# replace placeholders outside Git, and keep the file mode at 0600.
# Do not use production credentials.

# Telegram
BOT_TOKEN=
ADMIN_CHAT_ID=

# PostgreSQL, reachable only through the private Docker network.
DATABASE_URL=postgresql+asyncpg://workout_bot_staging:REPLACE_ME@postgres:5432/workout_bot_staging

# Redis is not used by any component: dialog state and answers live in
# PostgreSQL, gateway state lives in the process memory. Do not add REDIS_URL.

# Admin authentication.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
JWT_SECRET=
AI_SECRETS_KEY=

# MinIO, reachable only through the private Docker network.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=workout_staging
MINIO_SECRET_KEY=
MINIO_SECURE=false
MEDIA_BUCKET=workout-media
MEDIA_PUBLIC_BASE_URL=http://backend:8000

# Application behavior.
WORKOUT_DATA_DIR=/app/data
EXERCISE_MEDIA_MAX_PER_EXERCISE=5
PROGRAM_HTML_MEDIA_MODE=html
PROGRAM_PRIMARY_GENERATOR=ai
PROGRAM_FALLBACK_GENERATOR=deterministic
AUTO_GENERATE_PROGRAM_AFTER_FINALIZE=true

# LAN addresses for the browser-accessible Admin Web and API.
CORS_ORIGINS=http://192.168.1.3:3000
NEXT_PUBLIC_API_BASE=http://192.168.1.3:8000

# --- Распределённые компоненты (Component Registry) ---
# Шлюз Telegram обновляется независимо от сервера, поэтому сообщает о себе
# версию и версию контракта. Секретов в реестре не хранится.
#
# Коммит сборки, подставляется процессом деплоя.
BUILD_SHA=
# Общий секрет /internal/v1. Без него internal API отвечает 503.
# Сгенерировать: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=
# Адрес сервера во внутренней сети Docker: heartbeat не выходит наружу.
BACKEND_INTERNAL_URL=http://backend:8000
# Экземпляр шлюза. При добавлении второго экземпляра значение обязано
# отличаться, иначе записи в реестре перезапишут друг друга.
TELEGRAM_COMPONENT_ID=telegram-eu-1
TELEGRAM_COMPONENT_NAME=Telegram Gateway EU
# COMPONENT_REGION здесь НЕ задаётся: сервер и шлюз читают один env-файл, а
# размещение у них разное. Значение приходит из compose для каждого сервиса.

# Фиксированный адрес Telegram Gateway в сети workout_net.
# Хост направляет исходящий трафик именно этого адреса в WireGuard-туннель
# до EU-узла, потому что локальный провайдер блокирует api.telegram.org.
# Менять только вместе с ip rule на staging-хосте
# (см. docs/infrastructure/EU_VPN_HUB_REPORT.md).
TELEGRAM_BOT_IP=172.18.0.20

# --- Worker: retry и recovery фоновых операций (Phase 1.2-D) -------------------
# Экземпляр worker'а. Значение попадает в lease_owner: два экземпляра с
# одинаковым идентификатором продлевали бы аренду друг друга.
WORKER_COMPONENT_ID=worker-eu-1
WORKER_COMPONENT_NAME=Background Worker EU
# Фиксированный адрес worker'а в сети workout_net. Нужен по той же причине, что
# и у Gateway: worker повторяет доставку в Telegram, поэтому его egress тоже
# должен уходить в EU-туннель. Требует отдельного правила ip rule на хосте
# (см. docs/infrastructure/EU_VPN_HUB_REPORT.md).
WORKER_IP=172.18.0.21
# Значения повторов. Пусто — берутся значения по умолчанию из
# src/infrastructure/config.py (3 попытки, 60 с → 240 с, аренда 1860 с).
WORKER_POLL_INTERVAL_SECONDS=15
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_INITIAL_DELAY_SECONDS=60
WORKER_RETRY_MULTIPLIER=4
WORKER_RETRY_MAX_DELAY_SECONDS=900
WORKER_LEASE_SECONDS=1860
WORKER_BATCH_SIZE=5
# Отправку файлов worker не выполняет: доступа к api.telegram.org из RU нет.
# Он только возвращает в очередь доставки, чей отправитель исчез.

# --- Telegram Gateway за сетевой границей ---------------------------------------
# Аренда задания на отправку. Покрывает рендер HTML с изображениями и отправку
# документа с повторами: короткая аренда отдала бы задание второму экземпляру
# шлюза, и пользователь получил бы файл дважды.
TELEGRAM_DELIVERY_LEASE_SECONDS=300
