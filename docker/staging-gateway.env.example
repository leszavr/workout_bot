# Telegram Gateway (EU) — переменные окружения.
#
# Отдельный файл от `staging-app.env` намеренно: шлюз размещается в EU-сегменте
# и не должен иметь доступа к хранилищам RU. Общий env-файл дал бы ему
# DATABASE_URL, ключи MinIO и адрес Redis, даже если код ими не пользуется — а
# проверка независимости фактическая, а не по коду.
#
# Чего здесь НЕТ и быть не должно:
#   DATABASE_URL          — данных у шлюза нет, всё через internal API
#   REDIS_URL             — состояния во внешнем хранилище у шлюза нет вовсе
#   MINIO_*               — фотографии и медиа пишет Backend в RU
#   JWT_SECRET, AI_*      — админка и AI-контур к шлюзу не относятся
#   ADMIN_*               — у шлюза нет пользователей и ролей

# --- Telegram ---
BOT_TOKEN=
# Чат администратора. Уведомление о новой анкете собирает Backend и отдаёт
# шлюзу как обычное сообщение: Bot API доступен только из EU.
ADMIN_CHAT_ID=

# --- Доступ к Backend ---
# Единственный канал к данным. Тот же секрет, что в staging-app.env: обе стороны
# сравнивают его в константное время.
BACKEND_INTERNAL_URL=http://backend:8000
INTERNAL_SERVICE_TOKEN=

# Таймаут и повторы запроса. Три попытки с секундной паузой лечат мгновенную
# заминку туннеля RU↔EU, пока пользователь ещё ждёт ответа в чате.
BACKEND_REQUEST_TIMEOUT_SECONDS=15
BACKEND_REQUEST_RETRIES=3
BACKEND_RETRY_DELAY_SECONDS=1

# --- Очередь доставки программ ---
# Инициатором может быть только шлюз: он за NAT, входящих подключений нет.
TELEGRAM_DELIVERY_POLL_INTERVAL_SECONDS=5
TELEGRAM_DELIVERY_BATCH_SIZE=5

# --- Состояние диалога ---
# Внешнего хранилища у шлюза нет. Служебное состояние aiogram (изоляция
# параллельных обновлений одного пользователя) живёт в памяти процесса; позиция
# диалога и ответы анкеты — в PostgreSQL (RU). Рестарт контейнера ничего не
# теряет: диалог продолжается с того же места.

# --- Component Registry ---
TELEGRAM_COMPONENT_ID=telegram-gateway-eu-1
TELEGRAM_COMPONENT_NAME=Telegram Gateway EU
COMPONENT_REGION=EU
