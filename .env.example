# Скопируйте в .env и заполните реальными значениями.
# Секреты не должны попадать в репозиторий и образы Docker.

# Telegram bot token (https://t.me/BotFather)
BOT_TOKEN=

# ID чата администратора для уведомлений о новых анкетах
ADMIN_CHAT_ID=

# Каталог данных (абсолютный путь). По умолчанию: <корень проекта>/data
# WORKOUT_DATA_DIR=/var/lib/workout_bot/data

# --- PostgreSQL ---
# Локальный запуск: docker compose -f docker/docker-compose.yml --env-file .env up -d postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workout_bot
POSTGRES_USER=workout_bot
POSTGRES_PASSWORD=

# Строка подключения (asyncpg). Если не задана — используется файловое хранилище.
DATABASE_URL=postgresql+asyncpg://workout_bot:CHANGE_ME@localhost:5432/workout_bot

# --- Внутренний веб-интерфейс (админ) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
JWT_SECRET=

# Origin фронтенда для CORS (Next.js)
CORS_ORIGINS=http://localhost:3000

# Фронтенд (apps/web/.env.local): адрес backend API
# NEXT_PUBLIC_API_BASE=http://localhost:8000
