# Скопируйте в .env и заполните реальными значениями.
# Секреты не должны попадать в репозиторий и образы Docker.

# Telegram bot token (https://t.me/BotFather)
BOT_TOKEN=

# ID чата администратора для уведомлений о новых анкетах
ADMIN_CHAT_ID=

# Каталог данных (абсолютный путь). По умолчанию: <корень проекта>/data
# WORKOUT_DATA_DIR=/var/lib/workout_bot/data

# --- PostgreSQL ---
# Локальный запуск: docker compose -f docker/docker-compose.yml --env-file .env up -d postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workout_bot
POSTGRES_USER=workout_bot
POSTGRES_PASSWORD=

# Строка подключения (asyncpg). Если не задана — используется файловое хранилище.
DATABASE_URL=postgresql+asyncpg://workout_bot:CHANGE_ME@localhost:5432/workout_bot

# Отдельная база для тестов. Интеграционные тесты удаляют свои данные, поэтому
# рабочая база использоваться не должна: ./workout-manager.sh test откажется
# запускаться, если эта строка не задана или совпадает с DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://workout_test:CHANGE_ME@localhost:5433/workout_bot_test

# --- Redis (устойчивое состояние анкеты, FSM) ---
# Обязателен для Telegram-бота: без него анкета теряется при перезапуске
# процесса и не работает при нескольких экземплярах приложения.
# Локальный запуск: docker compose -f docker/docker-compose.yml --env-file .env up -d redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Внутренний веб-интерфейс (админ) ---
# Аварийный администратор: работает всегда, даже если таблица пользователей
# пуста или все пароли утрачены. Роль — admin. Пароль хранится только здесь,
# поэтому сменить его через интерфейс нельзя.
#
# Повседневных пользователей создавайте в разделе «Пользователи»: у них пароль
# хранится в базе как scrypt-хеш, есть роли admin/viewer и сброс пароля.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
JWT_SECRET=

# Origin фронтенда для CORS (Next.js)
CORS_ORIGINS=http://localhost:3000

# --- MinIO (object storage для фото упражнений) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MEDIA_BUCKET=workout-media
# Публичный базовый URL backend для абсолютных ссылок медиа (url-режим HTML)
MEDIA_PUBLIC_BASE_URL=http://localhost:8000

# Количество фото на упражнение (лимит импорта/HTML, не схемы БД)
EXERCISE_MEDIA_MAX_PER_EXERCISE=5
# Режим медиа в HTML: html (data-URI) или url (ссылки на media endpoint)
PROGRAM_HTML_MEDIA_MODE=html
# Генераторы: ai | deterministic
PROGRAM_PRIMARY_GENERATOR=ai
PROGRAM_FALLBACK_GENERATOR=deterministic
# Автогенерация программы после финализации анкеты
AUTO_GENERATE_PROGRAM_AFTER_FINALIZE=true

# --- Распределённые компоненты (Component Registry) ---
# Компоненты (сервер, шлюз Telegram, веб-интерфейс) обновляются независимо,
# поэтому каждый экземпляр сообщает о себе версию и версию контракта.
#
# Коммит сборки. Подставляется процессом сборки: BUILD_SHA=$(git rev-parse --short HEAD)
BUILD_SHA=
# Размещение экземпляра (RU/EU) — только для отображения в админке.
COMPONENT_REGION=RU
# Общий секрет service-to-service вызовов /internal/v1. Без него internal API
# отвечает 503: принимать неаутентифицированные heartbeat нельзя.
# Сгенерировать: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=
# Адрес backend для регистрации шлюза. Пусто — шлюз работает без регистрации
# (локальная разработка): реестр не должен быть условием запуска бота.
BACKEND_INTERNAL_URL=
# Идентификатор экземпляра шлюза. У разных экземпляров обязан различаться,
# иначе они перезапишут друг друга в реестре.
TELEGRAM_COMPONENT_ID=telegram-local-1
TELEGRAM_COMPONENT_NAME=Telegram Gateway

# --- Worker: retry и recovery фоновых операций (Phase 1.2-D) ---
# Фоновый исполнитель повторяет transient-отказы генерации и доставки и
# восстанавливает операции, чей процесс умер. Состояния не хранит: очередь
# повторов и аренда живут в PostgreSQL, поэтому Redis ему не нужен.
#
# Идентификатор экземпляра. Попадает в lease_owner: у двух экземпляров он
# обязан различаться, иначе аренда одного будет продлеваться от имени другого.
WORKER_COMPONENT_ID=worker-local-1
WORKER_COMPONENT_NAME=Background Worker
# Интервал опроса очереди, секунды.
WORKER_POLL_INTERVAL_SECONDS=15
# Всего попыток на операцию, включая исходную. Бесконечных повторов нет.
WORKER_MAX_ATTEMPTS=3
# Backoff: 60 с, затем ×4 (240 с), но не больше WORKER_RETRY_MAX_DELAY_SECONDS.
WORKER_RETRY_INITIAL_DELAY_SECONDS=60
WORKER_RETRY_MULTIPLIER=4
WORKER_RETRY_MAX_DELAY_SECONDS=900
# Аренда захваченной операции. Должна превышать максимальный бюджет генерации
# (1800 с), иначе job отберут у живого исполнителя и генерация пойдёт дважды.
WORKER_LEASE_SECONDS=1860
# Сколько операций берётся за один проход.
WORKER_BATCH_SIZE=5
# Повтор доставки требует BOT_TOKEN. false — повторяется только генерация.
WORKER_DELIVERY_ENABLED=true

# Фронтенд (apps/web/.env.local): адрес backend API
# NEXT_PUBLIC_API_BASE=http://localhost:8000
